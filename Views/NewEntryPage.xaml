<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MoodTracker.ViewModels"
             x:Class="MoodTracker.Views.NewEntryPage"
             Title="Neuer Eintrag"
             Shell.TabBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:NewEntryViewModel />
    </ContentPage.BindingContext>

    <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" 
                IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
        <VerticalStackLayout Padding="24" Spacing="20">
            <!-- Date Header -->
            <Label Text="{Binding EntryDate, StringFormat=' Heute, {0:dd. MMMM}'}"
                   FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   HorizontalOptions="Center"/>

            <!-- DOMINANT Mood Selector (Daylio Style) -->
            <VerticalStackLayout Spacing="15" Margin="0,10">
                <Label Text="Wie geht es dir?"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>
                
                <!-- Big Mood Display -->
                <Label Text="{Binding MoodEmoji}"
                       FontSize="120"
                       HorizontalOptions="Center"
                       HeightRequest="140"
                       VerticalTextAlignment="Center"/>
                
                <Label Text="{Binding MoodLabel}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{Binding MoodColor}"
                       HorizontalOptions="Center"/>

                <!-- Radial Selection -->
                <Grid HorizontalOptions="Center" WidthRequest="320" HeightRequest="60">
                    <HorizontalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Button Text="😢" 
                                Command="{Binding SelectMoodCommand}" CommandParameter="1"
                                Style="{StaticResource MoodButton}"
                                BackgroundColor="{Binding Mood, Converter={StaticResource MoodToColor}, ConverterParameter=1}"/>
                        <Button Text="😕" 
                                Command="{Binding SelectMoodCommand}" CommandParameter="2"
                                Style="{StaticResource MoodButton}"
                                BackgroundColor="{Binding Mood, Converter={StaticResource MoodToColor}, ConverterParameter=2}"/>
                        <Button Text="😐" 
                                Command="{Binding SelectMoodCommand}" CommandParameter="3"
                                Style="{StaticResource MoodButton}"
                                BackgroundColor="{Binding Mood, Converter={StaticResource MoodToColor}, ConverterParameter=3}"/>
                        <Button Text="🙂" 
                                Command="{Binding SelectMoodCommand}" CommandParameter="4"
                                Style="{StaticResource MoodButton}"
                                BackgroundColor="{Binding Mood, Converter={StaticResource MoodToColor}, ConverterParameter=4}"/>
                        <Button Text="😊" 
                                Command="{Binding SelectMoodCommand}" CommandParameter="5"
                                Style="{StaticResource MoodButton}"
                                BackgroundColor="{Binding Mood, Converter={StaticResource MoodToColor}, ConverterParameter=5}"/>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- Activities Grid (Daylio style icons) -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Was hast du gemacht?"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"/>
                
                <CollectionView ItemsSource="{Binding AvailableActivities}"
                                ItemsLayout="Grid, 4"
                                SelectionMode="None"
                                HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6">
                                <Frame BackgroundColor="{Binding BackgroundColor}"
                                       BorderColor="{Binding BorderColor}"
                                       Padding="0,12"
                                       CornerRadius="16"
                                       HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewEntryViewModel}}, Path=ToggleActivityCommand}" CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                        <Label Text="{Binding Icon}" FontSize="28" HorizontalOptions="Center"/>
                                        <Label Text="{Binding Name}" FontSize="11" HorizontalOptions="Center" TextColor="{Binding TextColor}"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Quick Stats Row -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Frame Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" Padding="15" CornerRadius="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="⚡" FontSize="24"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="ENERGIE" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                            <Slider Value="{Binding Energy}" Minimum="1" Maximum="10" HeightRequest="20"/>
                            <Label Text="{Binding Energy, StringFormat='{}{0}/10'}" FontSize="14" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
                
                <Frame Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" Padding="15" CornerRadius="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="😴" FontSize="24"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="SCHLAF" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                            <Stepper Value="{Binding Sleep}" Minimum