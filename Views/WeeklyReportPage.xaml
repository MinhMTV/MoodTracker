<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MoodTracker.ViewModels"
             x:Class="MoodTracker.Views.WeeklyReportPage"
             Title="Wochenbericht">

    <ContentPage.BindingContext>
        <vm:WeeklyReportViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Week Navigation -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                <Button Text="◀" Clicked="OnPreviousWeek"/>
                <Label Text="{Binding WeekLabel}" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Button Text="▶" Clicked="OnNextWeek"/>
            </HorizontalStackLayout>

            <!-- Loading -->
            <ActivityIndicator IsVisible="{Binding IsLoading}"
                               IsRunning="{Binding IsLoading}"
                               HorizontalOptions="Center"/>

            <!-- No Report -->
            <VerticalStackLayout IsVisible="{Binding HasReport, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Noch kein Bericht für diese Woche."
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"/>
                <Button Text="Bericht erstellen"
                        Clicked="OnGenerateReport"
                        Style="{StaticResource PrimaryButton}"/>
            </VerticalStackLayout>

            <!-- Report Content -->
            <VerticalStackLayout IsVisible="{Binding HasReport}" Spacing="15">
                <!-- AI Summary -->
                <Frame BackgroundColor="{StaticResource Gray100}" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🤖" FontSize="24"/>
                            <Label Text="KI-Zusammenfassung" 
                                   FontAttributes="Bold"
                                   FontSize="18"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding CurrentReport.Summary}"
                               FontSize="14"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Stats -->
                <Grid ColumnDefinitions="*,*,*">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="{Binding CurrentReport.EntryCount}" FontSize="32" FontAttributes="Bold"/>
                        <Label Text="Einträge" FontSize="12" TextColor="{StaticResource Gray500}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="{Binding CurrentReport.AverageMood, StringFormat='{}{0:F1}'}" FontSize="32" FontAttributes="Bold"/>
                        <Label Text="Ø Stimmung" FontSize="12" TextColor="{StaticResource Gray500}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label Text="{Binding CurrentReport.AverageEnergy, StringFormat='{}{0:F1}'}" FontSize="32" FontAttributes="Bold"/>
                        <Label Text="Ø Energie" FontSize="12" TextColor="{StaticResource Gray500}"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Patterns -->
                <Frame BorderColor="{StaticResource Gray300}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🔍 Erkannte Patterns" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding CurrentReport.Patterns}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="10" Padding="5">
                                        <Label Text="•" FontSize="16" TextColor="{StaticResource Primary}"/>
                                        <Label Text="{Binding .}" FontSize="14"/>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Coaching Tip -->
                <Frame BackgroundColor="#E8F5E9" BorderColor="#4CAF50" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="💡 Coaching-Tipp" FontAttributes="Bold" TextColor="#2E7D32"/>
                        <Label Text="{Binding CurrentReport.CoachingTip}"
                               FontSize="14"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Refresh -->
                <Button Text="Neu generieren"
                        Clicked="OnRefresh"
                        Style="{StaticResource SecondaryButton}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
