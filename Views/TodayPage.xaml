<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MoodTracker.ViewModels"
             x:Class="MoodTracker.Views.TodayPage"
             Title="Heute"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <ContentPage.BindingContext>
        <vm:TodayViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Navigation -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Padding="20,15" BackgroundColor="{AppThemeBinding Light={White}, Dark={StaticResource Gray900}}">
            <Button Grid.Column="0" 
                    Text="‹" 
                    FontSize="24"
                    Clicked="OnPreviousDay"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"/>
            
            <Label Grid.Column="1" Text="{Binding DateLabel}" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            
            <Button Grid.Column="2" 
                    Text="›" 
                    FontSize="24"
                    Clicked="OnNextDay"
                    HorizontalOptions="End"
                    IsEnabled="{Binding CanGoNext}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">
                <!-- No Entry State -->
                <VerticalStackLayout IsVisible="{Binding HasEntry, Converter={StaticResource InvertedBoolConverter}}"
                                    Spacing="25"
                                    VerticalOptions="CenterAndExpand"
                                    Margin="0,50">
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                           WidthRequest="200" HeightRequest="200"
                           CornerRadius="100"
                           HasShadow="False"
                           BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}">
                        <Label Text="📝" FontSize="80" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    
                    <Label Text="Wie geht es dir heute?" 
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           HorizontalOptions="Center"/>
                    
                    <Label Text="Tappe deine Stimmung, Energie und Aktivitäten"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalOptions="Center"/>
                    
                    <Button Text="Eintrag erstellen"
                            Clicked="OnCreateEntry"
                            Style="{StaticResource PrimaryButton}"
                            WidthRequest="200"
                            HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Entry Display -->
                <VerticalStackLayout IsVisible="{Binding HasEntry}" Spacing="15">
                    <!-- Mood Card -->
                    <Frame BackgroundColor="{Binding TodayEntry.MoodColor}"
                           CornerRadius="20"
                           Padding="30">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label Text="{Binding TodayEntry.MoodEmoji}"
                                   FontSize="80"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding TodayEntry.MoodLabel}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding TodayEntry.CreatedAt, StringFormat='{}{0:HH:mm} Uhr'}"
                                   FontSize="14"
                                   TextColor="White"
                                   Opacity="0.9"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Stats Row -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <Frame Grid.Column="0" 
                               BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                               Padding="20"
                               CornerRadius="16">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="⚡" FontSize="28"/>
                                <Label Text="ENERGIE" FontSize="10" TextColor="{StaticResource Gray500}" Margin="0,5"/>
                                <Label Text="{Binding TodayEntry.Energy, StringFormat='{}{0}/10'}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                            </VerticalStackLayout>
                        </Frame>
                        
                        <Frame Grid.Column="1"
                               BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                               BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                               Padding="20"
                               CornerRadius="16">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="😴" FontSize="28"/>
                                <Label Text="SCHLAF" FontSize="10" TextColor="{StaticResource Gray500}" Margin="0,5"/>
                                <Label Text="{Binding TodayEntry.Sleep, StringFormat='{}{0}h'}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- Activities -->
                    <Frame BackgroundColor="{AppThemeBinding Light={White}, Dark={StaticResource Gray800}}"
                           BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                           Padding