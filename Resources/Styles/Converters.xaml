<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:local="clr-namespace:MoodTracker.Converters">

    <!-- Bool Converters -->
    <local:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
    <local:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
    <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
    
    <!-- Mood Converters -->
    <local:MoodToColorConverter x:Key="MoodToColor"/>
    <local:MoodToSelectedConverter x:Key="MoodToSelected"/>

</ResourceDictionary>
